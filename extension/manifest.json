{
  "manifest_version": 3,
  "name": "Lapped",
  "version": "1.0.0",
  "description": "Adds a completed High Park lap count to your Strava activity.",
  "action": { "default_popup": "popup.html", "default_title": "Lapped" },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.strava.com/*", "http://localhost:3000/*"]
}
